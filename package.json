{
  "name": "cloudcanvas",
  "version": "0.7.0",
  "description": "CloudCanvas core: blits, thin handles over DOM elements on an infinite canvas",
  "type": "module",
  "main": "index.js",
  "sideEffects": false,
  "files": [
    "index.js",
    "kernel.js",
    "log.js",
    "core",
    "graphics",
    "dist",
    "README.md",
    "ARCHITECTURE.md",
    "GUIDE.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "testing.js"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "check:dist": "node scripts/build.js --check",
    "size": "node scripts/size.js",
    "size:check": "node scripts/size.js --check",
    "test": "node --test --import ./tests/helpers/setup.js tests/unit/*.test.js",
    "test:unit": "node --test --import ./tests/helpers/setup.js tests/unit/*.test.js",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.js"
  },
  "keywords": [
    "canvas",
    "gui",
    "blit",
    "dom",
    "infinite-canvas"
  ],
  "author": "Richard Christopher, NeoTec, LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CloudsEcosys/cloudcanvas.git"
  },
  "bugs": {
    "url": "https://github.com/CloudsEcosys/cloudcanvas/issues"
  },
  "homepage": "https://github.com/CloudsEcosys/cloudcanvas#readme",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./core": "./core/index.js",
    "./kernel": "./kernel.js",
    "./log": "./log.js",
    "./theme": "./graphics/theme.js",
    "./tokens": "./graphics/tokens.js",
    "./primitives": "./graphics/primitives/primitives.js",
    "./element": "./graphics/primitives/element.js",
    "./vectorizer": "./graphics/vectorizer.js",
    "./style-gates": "./graphics/style-gates.js",
    "./testing": "./testing.js",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.12.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.12.0",
    "playwright": "^1.62.1"
  }
}
