  "repository": {
    "type": "git",
    "url": "git+https://github.com/CloudsEcosys/cloudcanvas.git"
  },
  "bugs": {
    "url": "https://github.com/CloudsEcosys/cloudcanvas/issues"
  },
  "homepage": "https://github.com/CloudsEcosys/cloudcanvas#readme",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./kernel": "./kernel.js",
    "./log": "./log.js",
    "./theme": "./graphics/theme.js",
    "./tokens": "./graphics/tokens.js",
    "./primitives": "./graphics/primitives/primitives.js",
